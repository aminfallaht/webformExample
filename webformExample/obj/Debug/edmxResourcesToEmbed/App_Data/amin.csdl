<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="aminModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="Account">
    <Key>
      <PropertyRef Name="UserID" />
    </Key>
    <Property Name="UserID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="Username" Type="String" MaxLength="10" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="Pass" Type="String" MaxLength="10" FixedLength="false" Unicode="true" Nullable="false" />
  </EntityType>
  <EntityType Name="DataBaseBook">
    <Key>
      <PropertyRef Name="BookID" />
    </Key>
    <Property Name="BookName" Type="String" MaxLength="10" FixedLength="false" Unicode="true" />
    <Property Name="BookID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="Price" Type="Int64" />
    <NavigationProperty Name="OrderBooks" Relationship="Self.FK_OrderBook_DataBaseBook" FromRole="DataBaseBook" ToRole="OrderBook" />
  </EntityType>
  <EntityType Name="DataBaseCustomer">
    <Key>
      <PropertyRef Name="CustomerID" />
    </Key>
    <Property Name="CustomerID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="CustomerName" Type="String" MaxLength="10" FixedLength="false" Unicode="true" />
    <Property Name="CustomerAdress" Type="String" MaxLength="100" FixedLength="false" Unicode="true" />
    <NavigationProperty Name="OrderBooks" Relationship="Self.FK_OrderBook_DataBaseCustomer" FromRole="DataBaseCustomer" ToRole="OrderBook" />
  </EntityType>
  <EntityType Name="Lottery">
    <Key>
      <PropertyRef Name="LotteryID" />
    </Key>
    <Property Name="LotteryID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="PayID" Type="Int32" />
    <NavigationProperty Name="Pay" Relationship="Self.FK_Lottery_Pay" FromRole="Lottery" ToRole="Pay" />
  </EntityType>
  <EntityType Name="OrderBook">
    <Key>
      <PropertyRef Name="OrderID" />
    </Key>
    <Property Name="OrderID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="CustomerID" Type="Int32" />
    <Property Name="BookID" Type="Int32" />
    <NavigationProperty Name="DataBaseBook" Relationship="Self.FK_OrderBook_DataBaseBook" FromRole="OrderBook" ToRole="DataBaseBook" />
    <NavigationProperty Name="DataBaseCustomer" Relationship="Self.FK_OrderBook_DataBaseCustomer" FromRole="OrderBook" ToRole="DataBaseCustomer" />
    <NavigationProperty Name="Pays" Relationship="Self.FK_Pay_OrderBook" FromRole="OrderBook" ToRole="Pay" />
  </EntityType>
  <EntityType Name="Pay">
    <Key>
      <PropertyRef Name="PayID" />
    </Key>
    <Property Name="OrderID" Type="Int32" />
    <Property Name="Done" Type="Boolean" />
    <Property Name="PayID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <NavigationProperty Name="Lotteries" Relationship="Self.FK_Lottery_Pay" FromRole="Pay" ToRole="Lottery" />
    <NavigationProperty Name="OrderBook" Relationship="Self.FK_Pay_OrderBook" FromRole="Pay" ToRole="OrderBook" />
  </EntityType>
  <EntityType Name="sysdiagram">
    <Key>
      <PropertyRef Name="diagram_id" />
    </Key>
    <Property Name="name" Type="String" MaxLength="128" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="principal_id" Type="Int32" Nullable="false" />
    <Property Name="diagram_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="version" Type="Int32" />
    <Property Name="definition" Type="Binary" MaxLength="Max" FixedLength="false" />
  </EntityType>
  <Association Name="FK_OrderBook_DataBaseBook">
    <End Role="DataBaseBook" Type="Self.DataBaseBook" Multiplicity="0..1" />
    <End Role="OrderBook" Type="Self.OrderBook" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="DataBaseBook">
        <PropertyRef Name="BookID" />
      </Principal>
      <Dependent Role="OrderBook">
        <PropertyRef Name="BookID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_OrderBook_DataBaseCustomer">
    <End Role="DataBaseCustomer" Type="Self.DataBaseCustomer" Multiplicity="0..1" />
    <End Role="OrderBook" Type="Self.OrderBook" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="DataBaseCustomer">
        <PropertyRef Name="CustomerID" />
      </Principal>
      <Dependent Role="OrderBook">
        <PropertyRef Name="CustomerID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Lottery_Pay">
    <End Role="Pay" Type="Self.Pay" Multiplicity="0..1" />
    <End Role="Lottery" Type="Self.Lottery" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Pay">
        <PropertyRef Name="PayID" />
      </Principal>
      <Dependent Role="Lottery">
        <PropertyRef Name="PayID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Pay_OrderBook">
    <End Role="OrderBook" Type="Self.OrderBook" Multiplicity="0..1" />
    <End Role="Pay" Type="Self.Pay" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="OrderBook">
        <PropertyRef Name="OrderID" />
      </Principal>
      <Dependent Role="Pay">
        <PropertyRef Name="OrderID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="aminEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Accounts" EntityType="Self.Account" />
    <EntitySet Name="DataBaseBooks" EntityType="Self.DataBaseBook" />
    <EntitySet Name="DataBaseCustomers" EntityType="Self.DataBaseCustomer" />
    <EntitySet Name="Lotteries" EntityType="Self.Lottery" />
    <EntitySet Name="OrderBooks" EntityType="Self.OrderBook" />
    <EntitySet Name="Pays" EntityType="Self.Pay" />
    <EntitySet Name="sysdiagrams" EntityType="Self.sysdiagram" />
    <AssociationSet Name="FK_OrderBook_DataBaseBook" Association="Self.FK_OrderBook_DataBaseBook">
      <End Role="DataBaseBook" EntitySet="DataBaseBooks" />
      <End Role="OrderBook" EntitySet="OrderBooks" />
    </AssociationSet>
    <AssociationSet Name="FK_OrderBook_DataBaseCustomer" Association="Self.FK_OrderBook_DataBaseCustomer">
      <End Role="DataBaseCustomer" EntitySet="DataBaseCustomers" />
      <End Role="OrderBook" EntitySet="OrderBooks" />
    </AssociationSet>
    <AssociationSet Name="FK_Lottery_Pay" Association="Self.FK_Lottery_Pay">
      <End Role="Pay" EntitySet="Pays" />
      <End Role="Lottery" EntitySet="Lotteries" />
    </AssociationSet>
    <AssociationSet Name="FK_Pay_OrderBook" Association="Self.FK_Pay_OrderBook">
      <End Role="OrderBook" EntitySet="OrderBooks" />
      <End Role="Pay" EntitySet="Pays" />
    </AssociationSet>
  </EntityContainer>
</Schema>